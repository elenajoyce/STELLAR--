# stellarwarden testnet environment example
# Copy to .env and fill in your values before running deploy scripts.

# Your Stellar CLI identity name (created with: stellar keys generate --global <name> --network testnet)
STELLAR_SOURCE=alice

# Network to deploy to
STELLAR_NETWORK=testnet

# Deployed contract IDs (filled in by deploy-full-stack-testnet.sh)
ALLOWLIST_TOKEN_CONTRACT_ID=
DENYLIST_GATE_CONTRACT_ID=
JURISDICTION_FLAG_CONTRACT_ID=
AUDIT_LOG_CONTRACT_ID=
CIRCUIT_BREAKER_CONTRACT_ID=
COMPLIANCE_AGGREGATOR_CONTRACT_ID=
MULTISIG_ADMIN_CONTRACT_ID=
POLICY_ENGINE_CONTRACT_ID=
